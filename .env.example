# ==============================================================================
# AulaScribe - Variables de Entorno de Ejemplo
# Copia este fichero a '.env' y completa las variables según tus necesidades.
# ==============================================================================

# --- Servidor y Almacenamiento ---
AULASCRIBE_HOST=0.0.0.0
AULASCRIBE_PORT=8000
AULASCRIBE_DATA_DIR=./data

# --- Motor de Transcripción (Whisper) ---
# Opciones disponibles:
#   - 'groq'          : Ultra-rápido en la nube, capa gratuita generosa (recomendado para empezar sin GPU)
#   - 'openai'        : API oficial de OpenAI Whisper
#   - 'faster-whisper': Local en tu máquina (requiere paquete opcional 'local-whisper')
WHISPER_PROVIDER=groq

# Claves de API de Transcripción (según el proveedor elegido):
GROQ_API_KEY=tu_api_key_de_groq_aqui
OPENAI_API_KEY=tu_api_key_de_openai_aqui

# Configuración para faster-whisper local:
# Modelos: tiny, base, small, medium, large-v3
LOCAL_WHISPER_MODEL=base
LOCAL_WHISPER_DEVICE=auto
LOCAL_WHISPER_COMPUTE_TYPE=int8

# --- Motor de Generación de Apuntes (LLM) ---
# Opciones disponibles:
#   - 'groq'       : llama-3.3-70b-versatile, qwen-2.5, etc.
#   - 'openai'     : gpt-4o, gpt-4o-mini
#   - 'anthropic'  : claude-3-5-sonnet-20241022
#   - 'gemini'     : gemini-1.5-flash, gemini-2.0-flash
#   - 'ollama'     : llama3.3, mistral, etc. (Local)
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile

# Claves de API para LLM:
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# --- Integraciones y Exportación (MCP / Local) ---
# Ruta absoluta a tu bóveda (Vault) de Obsidian (ejemplo: /home/usuario/Documents/ObsidianVault):
OBSIDIAN_VAULT_PATH=

# Token de integración de Notion (opcional):
NOTION_API_KEY=
NOTION_DATABASE_ID=
